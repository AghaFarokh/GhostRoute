[Unit]
Description=GhostRoute cloudflared tunnel (@SERVICE_NAME@)
After=network-online.target @SERVICE_NAME@.service

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=-@INSTALL_DIR@/.env
ExecStart=/bin/bash @INSTALL_DIR@/deploy/tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
